{
  "name": "nomad-loop-engine",
  "private": true,
  "version": "0.2.0",
  "description": "Autonomous exploratory testing: explores web apps like a user, finds bugs, writes reproducible Playwright tests.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*",
    "targets/*",
    "benchmarks"
  ],
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "target": "npm --workspace buggy-shop start",
    "nomad": "node packages/engine/dist/cli/nomad.js",
    "bench": "npm --workspace @nomad/benchmarks run bench --"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "wait-on": "^8.0.5"
  }
}
