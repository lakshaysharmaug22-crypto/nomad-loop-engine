# Copy to apps/web/.env.local. Without NEXT_PUBLIC_API_URL the dashboard serves the recorded runs in public/demo.
# NEXT_PUBLIC_API_URL=http://localhost:8100
# NEXT_PUBLIC_REPO_URL=https://github.com/<you>/nomad-loop-engine
# Public URL of the dashboard, used for social preview links.
# NEXT_PUBLIC_SITE_URL=https://nomad.example.com
