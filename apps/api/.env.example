# Copy to apps/api/.env (or export). Everything is optional.
PORT=8100
DATA_DIR=data
# ML service: trained ranker, MiniLM embeddings, local LLM bridge
ML_URL=http://localhost:8200
# Production adapters. Without them: run folders on disk + in-process queue.
# DATABASE_URL=postgres://nomad:nomad@localhost:5432/nomad
# REDIS_URL=redis://localhost:6379
RUN_CONCURRENCY=2
CORS_ORIGIN=*
